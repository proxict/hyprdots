SCROLL_INDEX=0
NEXT_SCROLL_TIMESTAMP=0

build-text() {
    local ARTIST="$1"
    local ALBUM="$2"
    local TITLE="$3"

    local TEXT=""
    local DELIM=""
    [ -n "${ARTIST}" ] && TEXT="${TEXT}${DELIM}${ARTIST}" && DELIM=" - "
    [ -n "${ALBUM}" ]  && TEXT="${TEXT}${DELIM}${ALBUM}"  && DELIM=" - "
    [ -n "${TITLE}" ]  && TEXT="${TEXT}${DELIM}${TITLE}"  && DELIM=" - "

    #TEXT="${TEXT//&lt/<}"
    #TEXT="${TEXT//&gt/>}"
    #TEXT="${TEXT//&amp/\&}"

    REPLY="${TEXT}"
}

print-text() {
    local ICON="$1"
    local TEXT="$2"
    local TOOLTIP="$3"

    jq -M --unbuffered --compact-output -n \
        --arg text "${ICON} ${TEXT}" \
        --arg tooltip "${TOOLTIP}" \
        --arg class "audio-meta" \
            '{text: $text, tooltip: $tooltip, class: $class}'
}

scroll-text() {
    local ICON="$1"
    local TEXT="$2"
    local MAX_LEN="$3"
    local LEN=${#TEXT}

    local TIME_MS="$(( ${EPOCHREALTIME/[^0-9]/} / 1000 ))"
    if (( ${EPOCHREALTIME/[^0-9]/} / 1000 > NEXT_SCROLL_TIMESTAMP )); then
        ((++SCROLL_INDEX))
        (( SCROLL_INDEX + 1 > (LEN - MAX_LEN) )) && NEXT_SCROLL_TIMESTAMP="$(( TIME_MS + 1000 ))"
        (( SCROLL_INDEX > (LEN - MAX_LEN) )) && SCROLL_INDEX=0 && NEXT_SCROLL_TIMESTAMP="$(( TIME_MS + 1000 ))"
    fi

    print-text "${ICON}" "${TEXT:${SCROLL_INDEX}:${MAX_LEN}}" "${TEXT}"
}

main() {
    local MAX_LEN=${1:-80}
    local PLAYERNAME STATUS ALBUM ARTIST TITLE TEXT COLOR

    while IFS='␞' read -r PLAYERNAME STATUS ALBUM ARTIST TITLE; do
        build-text "${ARTIST}" "${ALBUM}" "${TITLE}"
        TEXT="${REPLY}"
        TEXT_LEN="${#TEXT}"
        COLOR="#BF6161"
        [ "${STATUS}" = "Playing" ] && COLOR="#A3BE8C"

        case "${PLAYERNAME,,}" in
            spotify ) ICON="<span foreground='${COLOR}'></span>" ;;
            plexamp ) ICON="<span foreground='${COLOR}'>󰚺</span>" ;;
        esac

        if (( TEXT_LEN > MAX_LEN )); then
            while true; do
                if IFS='␞' read -t 0.2 -r PLAYERNAME STATUS ALBUM ARTIST TITLE; then
                    build-text "${ARTIST}" "${ALBUM}" "${TITLE}"
                    TEXT="${REPLY}"
                    TEXT_LEN="${#TEXT}"
                    if (( TEXT_LEN <= MAX_LEN )); then
                        print-text "${ICON}" "${TEXT}" "${TEXT}"
                        break
                    fi

                    COLOR="#BF6161"
                    [ "${STATUS}" = "Playing" ] && COLOR="#A3BE8C"

                    case "${PLAYERNAME,,}" in
                        spotify ) ICON="<span foreground='${COLOR}'></span>" ;;
                        plexamp ) ICON="<span foreground='${COLOR}'>󰚺</span>" ;;
                    esac
                fi
                scroll-text "${ICON}" "${TEXT}" "${MAX_LEN}"
            done
        else
            print-text "${ICON}" "${TEXT}" "${TEXT}"
        fi
    done
}

main "$@"
